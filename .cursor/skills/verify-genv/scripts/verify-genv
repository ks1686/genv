#!/usr/bin/env bash
# Isolate genv from the operator account. The tmux server inherits that
# account's environment, so the session must start from an empty env or it
# will read and write the real config directory.
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
REPO=$(CDPATH= cd "$SCRIPT_DIR/../../../.." && pwd)

CURRENT_FILE=${GENV_VERIFY_CURRENT:-/tmp/genv-verify-current}
RUNS_ROOT=${GENV_VERIFY_RUNS:-/tmp/genv-verify-runs}
EVIDENCE_ROOT=${GENV_VERIFY_EVIDENCE:-/tmp/genv-verify-evidence}

die() {
  printf 'verify-genv: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
usage: verify-genv <command> [args]

  launch
  doctor
  paths <home|spec-dir|spec|evidence|binary|session|run-id>
  drive [--until EXTENDED_REGEX] [--timeout SECONDS] -- <command>
  respond [--until EXTENDED_REGEX] [--timeout SECONDS] -- [text]
  capture <evidence-name> <absolute-path>
  cleanup

drive types <command> into the session and waits until a pane line matches
--until. The default match is a line GENV_DRIVE_EXIT:<code>, and drive then
exits with that code. respond types text and Enter. An empty text sends only
Enter. --until is an extended regular expression.

Set GENV_VERIFY_RUN to a run id to select a session other than the latest
launch. Set GENV_VERIFY_EVIDENCE to the directory that should keep proof.
cleanup deletes the session and the throwaway home. It leaves the evidence
directory in place.
EOF
}

tmux_cmd() {
  if [[ -f /exec-daemon/tmux.portal.conf ]]; then
    tmux -f /exec-daemon/tmux.portal.conf "$@"
  else
    tmux "$@"
  fi
}

config_fingerprint() {
  local dir=$1 path
  if [[ ! -e "$dir" ]]; then
    printf 'ABSENT\n'
    return 0
  fi
  {
    printf 'EXISTS\n'
    find "$dir" -print | LC_ALL=C sort | while IFS= read -r path; do
      if [[ -f "$path" ]]; then
        cksum "$path"
      else
        printf 'node %s\n' "$path"
      fi
    done
  } | cksum | awk '{print $1 "-" $2}'
}

write_operator_watch() {
  local dest=$1 home phys xdg path fp
  home=$2
  : >"$dest"
  path=$home/.config/genv
  fp=$(config_fingerprint "$path")
  printf '%s\t%s\n' "$fp" "$path" >>"$dest"
  if phys=$(CDPATH= cd "$home" && pwd -P); then
    if [[ "$phys" != "$home" ]]; then
      path=$phys/.config/genv
      fp=$(config_fingerprint "$path")
      printf '%s\t%s\n' "$fp" "$path" >>"$dest"
    fi
  fi
  if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    path=${XDG_CONFIG_HOME%/}/genv
    case "$path" in
      "$home/.config/genv") ;;
      *)
        fp=$(config_fingerprint "$path")
        printf '%s\t%s\n' "$fp" "$path" >>"$dest"
        ;;
    esac
  fi
}

check_operator_watch() {
  local file=$1 fp path now
  [[ -f "$file" ]] || {
    printf 'verify-genv: missing operator watch file %s\n' "$file" >&2
    return 1
  }
  while IFS=$'\t' read -r fp path; do
    [[ -n "${path:-}" ]] || continue
    now=$(config_fingerprint "$path")
    if [[ "$now" != "$fp" ]]; then
      printf 'verify-genv: operator config changed at %s (was %s, now %s)\n' "$path" "$fp" "$now" >&2
      return 1
    fi
  done <"$file" || true
  return 0
}

load_state() {
  local run=${GENV_VERIFY_RUN:-}
  if [[ -z "$run" ]]; then
    [[ -f "$CURRENT_FILE" ]] || die "no run yet. Run verify-genv launch first."
    run=$(cat "$CURRENT_FILE")
  fi
  RUN_DIR=$RUNS_ROOT/$run
  [[ -f "$RUN_DIR/run.env" ]] || die "run $run has no state at $RUN_DIR/run.env"
  # shellcheck disable=SC1091
  source "$RUN_DIR/run.env"
  RUN_ID=$run_id
  SESSION=$session
  RUN_DIR=$run_dir
  VERIFY_HOME=$verify_home
  XDG=$xdg
  BINDIR=$bindir
  EVIDENCE=$evidence
  OPERATOR_HOME=$operator_home
  REPO=$repo
}

pane_text() {
  tmux_cmd capture-pane -p -t "$SESSION" -S -10000
}

match_count() {
  local pane
  pane=$(pane_text)
  printf '%s\n' "$pane" | grep -c -E "$1" || true
}

wait_for_match() {
  local until=$1 before=$2 timeout=$3 deadline now
  deadline=$((SECONDS + timeout))
  while (( SECONDS < deadline )); do
    now=$(match_count "$until")
    if (( now > before )); then
      return 0
    fi
    sleep 0.2
  done
  pane_text >"$EVIDENCE/timeout.txt" || true
  die "timed out after ${timeout}s waiting for /$until/"
}

save_drive() {
  local label=$1
  local n dir
  dir=$EVIDENCE/drives
  mkdir -p "$dir"
  n=$(find "$dir" -name '*.txt' | wc -l | tr -d ' ')
  n=$((n + 1))
  {
    printf 'command: %s\n' "$label"
    pane_text
  } >"$(printf '%s/%03d.txt' "$dir" "$n")"
}

newest_exit_code() {
  pane_text | grep -E '^GENV_DRIVE_EXIT:[0-9]+$' | tail -n 1 | cut -d: -f2
}

type_text() {
  local text=$1
  if [[ -n "$text" ]]; then
    tmux_cmd send-keys -t "$SESSION" -l -- "$text"
  fi
  tmux_cmd send-keys -t "$SESSION" Enter
}

finish_drive() {
  local until=$1 label=$2 expect_exit=$3
  local code=0
  save_drive "$label"
  printf '%s\n' "$label" >>"$EVIDENCE/commands.log"
  if [[ "$expect_exit" -eq 1 ]]; then
    code=$(newest_exit_code)
    [[ -n "$code" ]] || die "command finished without GENV_DRIVE_EXIT"
    printf 'exit=%s\n' "$code" >>"$EVIDENCE/commands.log"
    return "$code"
  fi
  printf 'exit=prompt\n' >>"$EVIDENCE/commands.log"
  return 0
}

parse_until() {
  UNTIL='^GENV_DRIVE_EXIT:[0-9]+$'
  TIMEOUT=90
  EXPECT_EXIT=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --until)
        [[ $# -ge 2 ]] || die "drive/respond: --until needs a regex"
        UNTIL=$2
        shift 2
        ;;
      --timeout)
        [[ $# -ge 2 ]] || die "drive/respond: --timeout needs seconds"
        TIMEOUT=$2
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        die "drive/respond: unexpected argument $1"
        ;;
    esac
  done
  if [[ "$UNTIL" != ^GENV_DRIVE_EXIT:* ]]; then
    EXPECT_EXIT=0
  fi
  REMAINING=("$@")
}

cmd_launch() {
  local run home xdg bindir evidence session workdir
  local operator_home
  [[ -f "$REPO/go.mod" ]] || die "repository root $REPO has no go.mod"
  command -v go >/dev/null || die "go is not on PATH"
  command -v tmux >/dev/null || die "tmux is not on PATH"
  run=$(date -u +%Y%m%dT%H%M%SZ)-$$
  RUN_DIR=$RUNS_ROOT/$run
  home=$RUN_DIR/home
  xdg=$home/.config
  bindir=$RUN_DIR/bin
  workdir=$RUN_DIR/work
  evidence=$EVIDENCE_ROOT/$run
  session=genv-verify-$run
  operator_home=${HOME:-}
  [[ -n "$operator_home" ]] || die "HOME is empty. Refusing to launch."
  case "$home" in
    "$operator_home"|"$operator_home"/*) die "throwaway home $home is inside operator HOME" ;;
  esac
  case "$evidence" in
    "$RUN_DIR"|"$RUN_DIR"/*) die "evidence directory must sit outside the run directory" ;;
  esac
  mkdir -p "$home/.config" "$home/.cache" "$home/.local/share" "$bindir" "$workdir" "$evidence/drives"
  chmod 700 "$home" "$home/.config" "$home/.cache" "$home/.local"
  write_operator_watch "$evidence/operator-watch.tsv" "$operator_home"
  cp "$evidence/operator-watch.tsv" "$RUN_DIR/operator-watch.tsv"

  cat >"$RUN_DIR/inputrc" <<'EOF'
set enable-bracketed-paste off
set bell-style none
EOF
  cat >"$RUN_DIR/verify.bashrc" <<'EOF'
set +H
set +o history
PS1='GENVVERIFY> '
PROMPT_COMMAND='printf "GENV_DRIVE_EXIT:%s\n" "$?"'
EOF
  cat >"$RUN_DIR/start.sh" <<EOF
#!/bin/bash
exec env -i \\
  HOME='$home' \\
  XDG_CONFIG_HOME='$xdg' \\
  XDG_CACHE_HOME='$home/.cache' \\
  XDG_DATA_HOME='$home/.local/share' \\
  PATH='$bindir:/usr/bin:/bin' \\
  SHELL=/bin/bash \\
  TERM=xterm-256color \\
  USER='${USER:-verify}' \\
  LOGNAME='${USER:-verify}' \\
  INPUTRC='$RUN_DIR/inputrc' \\
  bash --noprofile --rcfile '$RUN_DIR/verify.bashrc' -i
EOF
  chmod 700 "$RUN_DIR/start.sh"

  if ! (cd "$REPO" && GOTOOLCHAIN=go1.26.10 go build -o "$bindir/genv" .) >"$evidence/build.log" 2>&1; then
    die "go build failed. See $evidence/build.log"
  fi
  {
    printf 'binary=%s\n' "$bindir/genv"
    (cd "$REPO" && GOTOOLCHAIN=go1.26.10 go version)
    "$bindir/genv" version
  } >>"$evidence/build.log"

  tmux_cmd new-session -d -s "$session" -c "$workdir" -- "$RUN_DIR/start.sh"
  SESSION=$session
  EVIDENCE=$evidence
  local deadline
  deadline=$((SECONDS + 20))
  while (( SECONDS < deadline )); do
    if pane_text | grep -q 'GENVVERIFY>'; then
      break
    fi
    sleep 0.2
  done
  if ! pane_text | grep -q 'GENVVERIFY>'; then
    tmux_cmd kill-session -t "$session" >/dev/null 2>&1 || true
    die "session did not reach the GENVVERIFY prompt"
  fi
  tmux_cmd pipe-pane -t "$session" -o "cat >> $(printf '%q' "$evidence/pane.log")" || printf 'verify-genv: pane log not attached\n' >&2

  cat >"$RUN_DIR/run.env" <<EOF
run_id='$run'
session='$session'
run_dir='$RUN_DIR'
verify_home='$home'
xdg='$xdg'
bindir='$bindir'
evidence='$evidence'
operator_home='$operator_home'
repo='$REPO'
EOF
  cp "$RUN_DIR/run.env" "$evidence/run.env"
  printf '%s\n' "$run" >"$CURRENT_FILE"
  printf 'run_id=%s\n' "$run"
  printf 'home=%s\n' "$home"
  printf 'spec_dir=%s\n' "$xdg/genv"
  printf 'evidence=%s\n' "$evidence"
  printf 'session=%s\n' "$session"
  printf 'binary=%s\n' "$bindir/genv"
}

cmd_paths() {
  load_state
  case "${1:-}" in
    home) printf '%s\n' "$VERIFY_HOME" ;;
    spec-dir) printf '%s\n' "$XDG/genv" ;;
    spec) printf '%s\n' "$XDG/genv/genv.json" ;;
    evidence) printf '%s\n' "$EVIDENCE" ;;
    binary) printf '%s\n' "$BINDIR/genv" ;;
    session) printf '%s\n' "$SESSION" ;;
    run-id) printf '%s\n' "$RUN_ID" ;;
    *)
      printf 'run_id=%s\n' "$RUN_ID"
      printf 'home=%s\n' "$VERIFY_HOME"
      printf 'spec_dir=%s\n' "$XDG/genv"
      printf 'spec=%s\n' "$XDG/genv/genv.json"
      printf 'evidence=%s\n' "$EVIDENCE"
      printf 'session=%s\n' "$SESSION"
      printf 'binary=%s\n' "$BINDIR/genv"
      ;;
  esac
}

cmd_drive() {
  local before label
  load_state
  tmux_cmd has-session -t "$SESSION" 2>/dev/null || die "session $SESSION is not running"
  parse_until "$@"
  [[ ${#REMAINING[@]} -gt 0 ]] || die "drive: missing command after --"
  label="${REMAINING[*]}"
  before=$(match_count "$UNTIL")
  type_text "$label"
  wait_for_match "$UNTIL" "$before" "$TIMEOUT"
  finish_drive "$UNTIL" "$label" "$EXPECT_EXIT"
}

cmd_respond() {
  local before text label
  load_state
  tmux_cmd has-session -t "$SESSION" 2>/dev/null || die "session $SESSION is not running"
  parse_until "$@"
  if [[ ${#REMAINING[@]} -eq 0 ]]; then
    text=
  elif [[ ${#REMAINING[@]} -eq 1 ]]; then
    text=${REMAINING[0]}
  else
    die "respond: pass one text argument after --"
  fi
  label="respond:${text}"
  before=$(match_count "$UNTIL")
  type_text "$text"
  wait_for_match "$UNTIL" "$before" "$TIMEOUT"
  finish_drive "$UNTIL" "$label" "$EXPECT_EXIT"
}

cmd_capture() {
  local name=$1 path=$2 dest
  [[ -n "${name:-}" && -n "${path:-}" ]] || die "capture: usage: verify-genv capture <name> <absolute-path>"
  load_state
  case "$name" in
    */*|*..*) die "capture: name must be a single path segment" ;;
  esac
  case "$path" in
    "$VERIFY_HOME"/*) ;;
    *) die "capture: $path is outside the throwaway home $VERIFY_HOME" ;;
  esac
  [[ -f "$path" ]] || die "capture: $path is not a file"
  dest=$EVIDENCE/$name
  cp -p "$path" "$dest"
  printf '%s\n' "$dest"
}

cmd_doctor() {
  local doctor_file line got
  load_state
  tmux_cmd has-session -t "$SESSION" 2>/dev/null || die "session $SESSION is not running"
  check_operator_watch "$EVIDENCE/operator-watch.tsv" || die "operator config changed"
  [[ -x "$BINDIR/genv" ]] || die "built binary missing at $BINDIR/genv"
  doctor_file=$VERIFY_HOME/.genv-verify-doctor
  rm -f "$doctor_file"
  cmd_drive -- 'printf "HOME=%s\nXDG=%s\nGENV=%s\nNOI=%s\nTARGET=%s\nHOSTENV=%s\nSHELL=%s\n" "$HOME" "$XDG_CONFIG_HOME" "$(command -v genv)" "${GENV_NO_INTERACTIVE-unset}" "${GENV_TARGET-unset}" "${GENV_HOST-unset}" "$SHELL" > "$HOME/.genv-verify-doctor"'
  [[ -f "$doctor_file" ]] || die "doctor file was not written"
  got=$(grep '^HOME=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "$VERIFY_HOME" ]] || die "HOME inside session is $got, want $VERIFY_HOME"
  got=$(grep '^XDG=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "$XDG" ]] || die "XDG_CONFIG_HOME inside session is $got, want $XDG"
  got=$(grep '^GENV=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "$BINDIR/genv" ]] || die "genv on PATH is $got, want $BINDIR/genv"
  got=$(grep '^NOI=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "unset" ]] || die "GENV_NO_INTERACTIVE is set inside the session ($got)"
  got=$(grep '^TARGET=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "unset" ]] || die "GENV_TARGET is set inside the session ($got)"
  got=$(grep '^HOSTENV=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "unset" ]] || die "GENV_HOST is set inside the session ($got)"
  got=$(grep '^SHELL=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "/bin/bash" ]] || die "SHELL inside session is $got, want /bin/bash"
  cmd_drive -- genv version
  line=$(pane_text | grep -E '^genv ' | tail -n 1 || true)
  [[ -n "$line" ]] || die "genv version did not print a version line"
  check_operator_watch "$EVIDENCE/operator-watch.tsv" || die "operator config changed"
  printf 'doctor ok\n%s\n' "$line"
}

cmd_cleanup() {
  local run evidence session
  run=${GENV_VERIFY_RUN:-}
  if [[ -z "$run" && -f "$CURRENT_FILE" ]]; then
    run=$(cat "$CURRENT_FILE")
  fi
  [[ -n "$run" ]] || {
    printf 'verify-genv: no run to clean\n' >&2
    exit 0
  }
  RUN_DIR=$RUNS_ROOT/$run
  evidence=$EVIDENCE_ROOT/$run
  if [[ -f "$RUN_DIR/run.env" ]]; then
    # shellcheck disable=SC1091
    source "$RUN_DIR/run.env"
  else
    session=genv-verify-$run
    if [[ -f "$evidence/run.env" ]]; then
      # shellcheck disable=SC1091
      source "$evidence/run.env"
    fi
  fi
  [[ -d "$evidence" ]] || die "evidence directory $evidence is missing before cleanup"
  [[ -f "$evidence/operator-watch.tsv" ]] || die "evidence is missing operator-watch.tsv"
  if tmux_cmd has-session -t "$session" 2>/dev/null; then
    tmux_cmd kill-session -t "$session"
  fi
  if tmux_cmd has-session -t "$session" 2>/dev/null; then
    die "session $session is still running"
  fi
  local watch_ok=0
  if check_operator_watch "$evidence/operator-watch.tsv"; then
    watch_ok=1
  fi
  rm -rf "$RUN_DIR"
  if [[ -f "$CURRENT_FILE" ]] && [[ "$(cat "$CURRENT_FILE")" == "$run" ]]; then
    rm -f "$CURRENT_FILE"
  fi
  [[ -d "$evidence" ]] || die "cleanup removed evidence directory $evidence"
  if [[ "$watch_ok" -ne 1 ]]; then
    printf 'operator config changed\n' >"$evidence/cleanup-failed.txt"
    die "cleanup removed the session, and the operator config fingerprint changed"
  fi
  printf 'session=dead\nhome=removed\nevidence=%s\n' "$evidence" >"$evidence/cleanup-ok.txt"
  printf 'cleaned %s\nevidence %s\n' "$run" "$evidence"
}

main() {
  local cmd=${1:-}
  if [[ -z "$cmd" ]]; then
    usage
    exit 1
  fi
  shift
  case "$cmd" in
    launch) cmd_launch "$@" ;;
    doctor) cmd_doctor "$@" ;;
    paths) cmd_paths "$@" ;;
    drive) cmd_drive "$@" ;;
    respond) cmd_respond "$@" ;;
    capture) cmd_capture "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command $cmd" ;;
  esac
}

main "$@"
