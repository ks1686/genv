#!/usr/bin/env bash
# Isolate genv from the operator account. The tmux server inherits that
# account's environment, so the session must start from an empty env or it
# will read and write the real config directory.
set -euo pipefail
umask 077

SCRIPT_DIR=$(CDPATH='' cd "$(dirname "$0")" && pwd)
REPO=$(CDPATH='' cd "$SCRIPT_DIR/../../../.." && pwd)

# Roots are chosen by ensure_roots. A caller-supplied directory is used as
# it is: this process never creates it and never chmods it.
RUNS_ROOT=
EVIDENCE_ROOT=
roots_ready=0
RUNTIME_PARENT=
ROOT_RECORD=
CHILD_DIR=

# launch_ok stays 0 until the session is up. The EXIT trap removes only this
# run, so a failed launch cannot leave a later cleanup aimed at an older one.
launch_ok=0
launch_run=
launch_session=
launch_run_dir=
launch_pid=
launch_pgid=
launch_user=
launch_identity=

RUN_ID=
SESSION=
RUN_DIR=
VERIFY_HOME=
XDG=
BINDIR=
EVIDENCE=
SESSION_TARGET=
PROC_PID=
PROC_PGID=
PROC_USER=
PROC_IDENTITY=

die() {
  printf 'verify-genv: %s\n' "$*" >&2
  exit 1
}

on_launch_exit() {
  local rc=$? live=
  trap - EXIT
  if [[ "$launch_ok" -eq 1 ]]; then
    exit "$rc"
  fi
  if [[ -n "$launch_pid" ]] && pid_alive "$launch_pid"; then
    live=$(live_pgid "$launch_pid")
    if launch_process_matches && [[ -n "$live" && "$live" == "$launch_pgid" ]]; then
      kill_group "$live" || true
    else
      printf 'verify-genv: launch failed and pid %s is not the process this run started. Leaving state in place.\n' "$launch_pid" >&2
      exit "$rc"
    fi
  fi
  if [[ -n "$launch_session" ]]; then
    tmux_cmd kill-session -t "$(tmux_session "$launch_session")" >/dev/null 2>&1 || true
  fi
  if [[ -n "$launch_run" ]]; then
    printf 'verify-genv: launch failed for run %s\n' "$launch_run" >&2
  fi
  if [[ -n "$launch_run" && -n "$RUNS_ROOT" && "$RUNS_ROOT" != "/" && "$launch_run_dir" == "$RUNS_ROOT/$launch_run" ]]; then
    remove_tree "$launch_run_dir" || true
  fi
  exit "$rc"
}

usage() {
  cat >&2 <<'EOF'
usage: verify-genv <command> [args]

  launch
  doctor
  paths <home|spec-dir|spec|evidence|binary|session|run-id>
  drive [--until EXTENDED_REGEX] [--timeout SECONDS] -- <command>
  respond [--until EXTENDED_REGEX] [--timeout SECONDS] -- [text]
  capture <evidence-name> <absolute-path>
  cleanup <run-id>
  classify [os-release-file] [proc-version-file] [uname]

drive types <command> into the session and waits until a pane line matches
--until. The default match is a line GENV_DRIVE_EXIT:<code>, and drive then
exits with that code. respond types text and Enter. An empty text sends only
Enter. --until is an extended regular expression.

Export GENV_VERIFY_RUN to the run_id launch printed before doctor, paths,
drive, respond, or capture. There is no current-run file. cleanup requires
that run id as an argument and does not guess. A run id matches
YYYYMMDDThhmmssZ-<pid>.

Set GENV_VERIFY_RUNS and GENV_VERIFY_EVIDENCE to private directories you own
that group and others cannot write. The harness does not create or chmod
those directories. When both are unset, launch creates one mode 700 directory
and records it under $XDG_RUNTIME_DIR/genv-verify (or /run/user/<uid> when
that runtime directory exists). It does not write into the home directory.
A command other than launch does not create that directory.

cleanup deletes the session and the throwaway home after the saved process
identity matches. It leaves the evidence directory in place.
EOF
}

tmux_cmd() {
  if [[ -f /exec-daemon/tmux.portal.conf ]]; then
    tmux -f /exec-daemon/tmux.portal.conf "$@"
  else
    tmux "$@"
  fi
}

# tmux treats a target as a prefix unless it starts with '='.
# has-session and kill-session take a session target ('=name').
# capture-pane, send-keys, and pipe-pane take a pane target, which needs
# '=name:' or the equals sign is read as part of the pane name.
tmux_session() {
  printf '=%s' "$1"
}

tmux_pane() {
  printf '=%s:' "$1"
}

# Proof files are sometimes on a filesystem that rejects chmod.
# Never chmod a directory the caller passed in. Callers pass roots, not
# these files. A symlink is left alone so chmod cannot follow it.
chmod_file() {
  local path=$1
  [[ -L "$path" ]] && return 0
  [[ -f "$path" ]] || return 0
  chmod 600 "$path" 2>/dev/null || true
}

# Go's module cache is mode 0555. A plain rm leaves it behind.
remove_tree() {
  local dir=$1
  [[ -n "$dir" && "$dir" != "/" && -d "$dir" && ! -L "$dir" ]] || return 0
  chmod -R u+w "$dir" 2>/dev/null || true
  rm -rf "$dir"
}

mode_digits() {
  local path=$1 mode
  mode=$(stat -c %a "$path" 2>/dev/null || stat -f %OLp "$path") || return 1
  printf '%s' "$mode"
}

# Return 0 when group or other has a write bit.
group_or_other_can_write() {
  local mode=$1 len g o
  len=${#mode}
  [[ "$len" -ge 2 ]] || return 0
  g=$((len - 2))
  o=$((len - 1))
  g=${mode:$g:1}
  o=${mode:$o:1}
  case "$g" in
    2|3|6|7) return 0 ;;
  esac
  case "$o" in
    2|3|6|7) return 0 ;;
  esac
  return 1
}

private_dir_ok() {
  local path=$1 mode
  [[ -n "$path" && "$path" != "/" ]] || return 1
  [[ -L "$path" ]] && return 1
  [[ -d "$path" && -O "$path" ]] || return 1
  mode=$(mode_digits "$path") || return 1
  if group_or_other_can_write "$mode"; then
    return 1
  fi
  return 0
}

require_private_dir() {
  local path=$1 label=$2 mode
  [[ -n "$path" && "$path" != "/" ]] || die "$label is missing"
  if [[ -L "$path" ]]; then
    die "$label is a symlink. Refusing to use it."
  fi
  if [[ ! -d "$path" ]]; then
    die "$label does not exist. Refusing to create it."
  fi
  if [[ ! -O "$path" ]]; then
    die "$label is not owned by $(id -un). Refusing to use it."
  fi
  mode=$(mode_digits "$path") || die "$label mode cannot be read"
  if group_or_other_can_write "$mode"; then
    die "$label is writable by group or others (mode $mode). Refusing to use it."
  fi
}

run_id_ok() {
  [[ "$1" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]]
}

under_home() {
  [[ -n "${HOME:-}" ]] || return 1
  case "$1" in
    "$HOME"|"$HOME"/*) return 0 ;;
  esac
  return 1
}

# A runtime directory is not the operator home. Never create ~/.cache for this.
runtime_parent() {
  local run_user
  RUNTIME_PARENT=
  if [[ -n "${XDG_RUNTIME_DIR:-}" ]] && private_dir_ok "$XDG_RUNTIME_DIR" && ! under_home "$XDG_RUNTIME_DIR"; then
    RUNTIME_PARENT=$XDG_RUNTIME_DIR
    return 0
  fi
  run_user=/run/user/$(id -u)
  if private_dir_ok "$run_user" && ! under_home "$run_user"; then
    RUNTIME_PARENT=$run_user
    return 0
  fi
  return 1
}

use_base() {
  local base=$1
  private_dir_ok "$base" || return 1
  private_dir_ok "$base/runs" || return 1
  private_dir_ok "$base/evidence" || return 1
  if under_home "$base"; then
    return 1
  fi
  RUNS_ROOT=$base/runs
  EVIDENCE_ROOT=$base/evidence
  return 0
}

read_root_record() {
  local file=$1 kind=$2 line val
  ROOT_RECORD=
  [[ -f "$file" && ! -L "$file" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == "$kind"=* ]] || continue
    val=${line#*=}
    ROOT_RECORD=$val
  done <"$file"
  [[ -n "$ROOT_RECORD" ]]
}

write_root_record() {
  local file=$1 kind=$2 value=$3 tmp line key
  case "$value" in
    *$'\n'*|*'='*) die "refusing to record a root path with a newline or extra '='" ;;
  esac
  tmp=$file.tmp.$$
  : >"$tmp"
  if [[ -f "$file" && ! -L "$file" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" == *=* ]] || continue
      key=${line%%=*}
      [[ "$key" == "$kind" ]] && continue
      printf '%s\n' "$line" >>"$tmp"
    done <"$file"
  fi
  printf '%s=%s\n' "$kind" "$value" >>"$tmp"
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$file"
}

# One directory holds both runs and evidence. Launch is the only command
# that creates it. Recording it under the home directory would touch the
# operator account, so the path is stored in the runtime directory.
create_default_base() {
  local base reg
  if ! runtime_parent; then
    die "no private runtime directory. Set GENV_VERIFY_RUNS and GENV_VERIFY_EVIDENCE. Refusing to write into the home directory."
  fi
  reg=$RUNTIME_PARENT/genv-verify
  if [[ ! -e "$reg" && ! -L "$reg" ]]; then
    mkdir -m 700 "$reg" || die "cannot create $reg"
  fi
  private_dir_ok "$reg" || die "registry $reg is not private"
  if [[ -f "$reg/roots" ]] && read_root_record "$reg/roots" base && use_base "$ROOT_RECORD"; then
    return 0
  fi
  base=$(mktemp -d "${TMPDIR:-/tmp}/genv-verify-base.XXXXXX") || die "mktemp failed"
  chmod 700 "$base" || die "cannot set mode 700 on $base"
  mkdir -m 700 "$base/runs" "$base/evidence" || die "cannot create runs and evidence under $base"
  use_base "$base" || die "temporary directory $base is not private"
  write_root_record "$reg/roots" base "$base"
}

load_default_base() {
  local reg
  if ! runtime_parent; then
    die "GENV_VERIFY_RUNS and GENV_VERIFY_EVIDENCE are unset, and there is no private runtime directory. Refusing to create directories or write into the home directory."
  fi
  reg=$RUNTIME_PARENT/genv-verify
  if [[ ! -f "$reg/roots" ]] || ! read_root_record "$reg/roots" base; then
    die "no verify-genv root is recorded. Refusing to create one."
  fi
  use_base "$ROOT_RECORD" || die "recorded verify-genv root is not private"
}

ensure_roots() {
  local create=0 runs_set=0 ev_set=0
  [[ "$roots_ready" -eq 1 ]] && return 0
  [[ "${1:-}" == create ]] && create=1
  [[ -n "${GENV_VERIFY_RUNS+x}" ]] && runs_set=1
  [[ -n "${GENV_VERIFY_EVIDENCE+x}" ]] && ev_set=1
  if [[ "$runs_set" -ne "$ev_set" ]]; then
    die "set both GENV_VERIFY_RUNS and GENV_VERIFY_EVIDENCE, or set neither"
  fi
  if [[ "$runs_set" -eq 1 ]]; then
    [[ -n "$GENV_VERIFY_RUNS" ]] || die "GENV_VERIFY_RUNS is empty"
    [[ -n "$GENV_VERIFY_EVIDENCE" ]] || die "GENV_VERIFY_EVIDENCE is empty"
    require_private_dir "$GENV_VERIFY_RUNS" "GENV_VERIFY_RUNS"
    require_private_dir "$GENV_VERIFY_EVIDENCE" "GENV_VERIFY_EVIDENCE"
    RUNS_ROOT=$GENV_VERIFY_RUNS
    EVIDENCE_ROOT=$GENV_VERIFY_EVIDENCE
  elif [[ "$create" -eq 1 ]]; then
    create_default_base
  else
    load_default_base
  fi
  [[ "$RUNS_ROOT" != "$EVIDENCE_ROOT" ]] || die "runs and evidence directories must be different"
  [[ "$RUNS_ROOT" != "/" && "$EVIDENCE_ROOT" != "/" ]] || die "refusing to use /"
  roots_ready=1
}

make_private_child() {
  local root=$1 name=$2 tmp dest
  CHILD_DIR=
  run_id_ok "$name" || die "refusing to create $root/$name"
  private_dir_ok "$root" || die "$root is not a private directory"
  dest=$root/$name
  if [[ -e "$dest" || -L "$dest" ]]; then
    die "refusing to reuse existing directory $dest"
  fi
  tmp=$(mktemp -d "$root/.tmp.XXXXXX") || die "mktemp failed in $root"
  chmod 700 "$tmp" || die "cannot set mode 700 on $tmp"
  if ! mv "$tmp" "$dest"; then
    chmod -R u+w "$tmp" 2>/dev/null || true
    rm -rf "$tmp"
    die "cannot create $dest"
  fi
  private_dir_ok "$dest" || die "$dest is not private"
  CHILD_DIR=$dest
}

config_fingerprint() {
  local dir=$1 path
  if [[ ! -e "$dir" && ! -L "$dir" ]]; then
    printf 'ABSENT\n'
    return 0
  fi
  {
    printf 'EXISTS\n'
    if [[ -L "$dir" ]]; then
      printf 'link %s\n' "$(readlink "$dir")"
    fi
    find "$dir" -print | LC_ALL=C sort | while IFS= read -r path; do
      if [[ -L "$path" ]]; then
        printf 'link %s %s\n' "$path" "$(readlink "$path")"
      elif [[ -f "$path" ]]; then
        cksum "$path"
      else
        printf 'node %s\n' "$path"
      fi
    done
  } | cksum | awk '{print $1 "-" $2}'
}

record_watch() {
  local dest=$1 path=$2 fp
  fp=$(config_fingerprint "$path")
  printf '%s\t%s\n' "$fp" "$path" >>"$dest"
}

write_operator_watch() {
  local dest=$1 home phys path
  home=$2
  : >"$dest"
  record_watch "$dest" "$home/.config/genv"
  record_watch "$dest" "$home/.bashrc"
  record_watch "$dest" "$home/.zshrc"
  if phys=$(CDPATH='' cd "$home" && pwd -P); then
    if [[ "$phys" != "$home" ]]; then
      record_watch "$dest" "$phys/.config/genv"
      record_watch "$dest" "$phys/.bashrc"
      record_watch "$dest" "$phys/.zshrc"
    fi
  fi
  if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    path=${XDG_CONFIG_HOME%/}/genv
    case "$path" in
      "$home/.config/genv") ;;
      *) record_watch "$dest" "$path" ;;
    esac
  fi
  chmod_file "$dest"
}

check_operator_watch() {
  local file=$1 fp path now
  [[ -f "$file" && ! -L "$file" ]] || {
    printf 'verify-genv: missing operator watch file %s\n' "$file" >&2
    return 1
  }
  while IFS=$'\t' read -r fp path; do
    [[ -n "${path:-}" ]] || continue
    now=$(config_fingerprint "$path")
    if [[ "$now" != "$fp" ]]; then
      printf 'verify-genv: operator config changed at %s (was %s, now %s)\n' "$path" "$fp" "$now" >&2
      return 1
    fi
  done <"$file" || true
  return 0
}

# Match genv's host classifier: ID and ID_LIKE tokens, plus a WSL proc line.
os_release_has() {
  local file=$1 target=$2 line key val part
  target=$(printf '%s' "$target" | tr '[:upper:]' '[:lower:]')
  [[ -n "$target" && -r "$file" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || continue
    key=${line%%=*}
    val=${line#*=}
    key=$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')
    key=${key#"${key%%[![:space:]]*}"}
    key=${key%"${key##*[![:space:]]}"}
    val=${val#"${val%%[![:space:]]*}"}
    val=${val%"${val##*[![:space:]]}"}
    val=$(printf '%s' "$val" | tr '[:upper:]' '[:lower:]' | sed "s/^[\"']*//; s/[\"']*$//")
    case "$key" in
      id)
        [[ "$val" == "$target" ]] && return 0
        ;;
      id_like)
        for part in $val; do
          part=$(printf '%s' "$part" | sed "s/^[\"']*//; s/[\"']*$//")
          [[ "$part" == "$target" ]] && return 0
        done
        ;;
    esac
  done <"$file"
  return 1
}

classify_host() {
  local os_file=$1 proc_file=$2 uname_s=$3
  case "$uname_s" in
    Darwin) printf 'macos\n'; return 0 ;;
    MINGW*|MSYS*|CYGWIN*) printf 'windows\n'; return 0 ;;
    Linux) ;;
    *) return 0 ;;
  esac
  local wsl=0
  if [[ -r "$proc_file" ]] && grep -Eiq 'microsoft|wsl' "$proc_file"; then
    wsl=1
  fi
  if [[ "$wsl" -eq 1 ]] && os_release_has "$os_file" arch; then
    printf 'wsl-arch\n'
    return 0
  fi
  if [[ "$wsl" -eq 1 ]] && os_release_has "$os_file" ubuntu; then
    printf 'ubuntu\n'
    return 0
  fi
  if [[ "$wsl" -eq 1 ]]; then
    return 0
  fi
  if os_release_has "$os_file" arch; then
    printf 'arch\n'
    return 0
  fi
  if os_release_has "$os_file" ubuntu; then
    printf 'ubuntu\n'
    return 0
  fi
}

cmd_classify() {
  local os_file=${1:-/etc/os-release}
  local proc_file=${2:-/proc/version}
  local uname_s=${3:-$(uname -s)}
  local class
  class=$(classify_host "$os_file" "$proc_file" "$uname_s")
  printf 'host_class=%s\n' "$class"
  if [[ -z "$class" ]]; then
    printf 'session_target=linux\n'
  else
    printf 'session_target=\n'
  fi
}

# run.env is data. Sourcing it would run whatever was written into the directory.
load_run_record() {
  local file=$1 expected=$2
  local line key val got_session got_target saw_id
  got_session=
  got_target=
  saw_id=0
  [[ -f "$file" && ! -L "$file" ]] || die "run.env is missing: $file"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line=${line%$'\r'}
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || die "run.env is not key=value data: $file"
    key=${line%%=*}
    val=${line#*=}
    case "$key" in
      run_id|session|host_class|session_target) ;;
      run_dir|verify_home|xdg|bindir|evidence|repo) continue ;;
      *) die "run.env has an unknown key" ;;
    esac
    case "$key" in
      run_id)
        run_id_ok "$val" || die "run.env run_id is not a run id"
        [[ "$val" == "$expected" ]] || die "run.env id does not match"
        saw_id=1
        ;;
      session)
        got_session=$val
        ;;
      host_class)
        case "$val" in
          ""|macos|windows|arch|ubuntu|wsl-arch) ;;
          *) die "run.env host_class is not a known class" ;;
        esac
        ;;
      session_target)
        case "$val" in
          ""|linux|macos|windows|arch|ubuntu|wsl-arch) got_target=$val ;;
          *) die "run.env session_target is not a known target" ;;
        esac
        ;;
    esac
  done <"$file"
  [[ "$saw_id" -eq 1 ]] || die "run.env has no run_id"
  [[ "$got_session" == "genv-verify-$expected" ]] || die "run.env session does not match"
  # Paths come from the id and the private roots, never from the file.
  RUN_ID=$expected
  SESSION=genv-verify-$expected
  RUN_DIR=$RUNS_ROOT/$expected
  VERIFY_HOME=$RUN_DIR/home
  XDG=$VERIFY_HOME/.config
  BINDIR=$RUN_DIR/bin
  EVIDENCE=$EVIDENCE_ROOT/$expected
  SESSION_TARGET=$got_target
}

load_state() {
  local run=${GENV_VERIFY_RUN:-}
  ensure_roots
  [[ -n "$run" ]] || die "GENV_VERIFY_RUN is empty. Export the run_id launch printed. This harness does not guess a current run."
  run_id_ok "$run" || die "GENV_VERIFY_RUN is not a run id"
  [[ -f "$RUNS_ROOT/$run/run.env" ]] || die "run $run has no state at $RUNS_ROOT/$run/run.env"
  load_run_record "$RUNS_ROOT/$run/run.env" "$run"
  [[ -d "$VERIFY_HOME" && ! -L "$VERIFY_HOME" ]] || die "throwaway home is missing"
  [[ -d "$EVIDENCE" && ! -L "$EVIDENCE" ]] || die "evidence directory is missing"
  private_dir_ok "$EVIDENCE" || die "evidence directory is not private"
}

# A failing ps (for example /proc is hidden) must not look like a dead pid.
# That would let cleanup remove the run and leave a background process alive.
require_ps() {
  if ! ps -p $$ >/dev/null 2>&1; then
    die "ps cannot list processes. Refusing to treat a pid as dead."
  fi
}

pid_alive() {
  local pid=$1
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  require_ps
  ps -p "$pid" >/dev/null 2>&1
}

live_pgid() {
  require_ps
  ps -o pgid= -p "$1" 2>/dev/null | tr -d '[:space:]' || true
}

ps_user() {
  ps -o user= -p "$1" 2>/dev/null | tr -d '[:space:]' || true
}

# Same command on every check so the saved line can be compared on macOS,
# where /proc does not exist. TZ=UTC0 keeps the date stable.
process_identity() {
  TZ=UTC0 LC_ALL=C ps -o lstart= -o command= -p "$1" 2>/dev/null || true
}

own_pgid() {
  ps -o pgid= -p $$ | tr -d '[:space:]'
}

group_has_processes() {
  local pgid=$1 line lines
  require_ps
  lines=$(ps -eo pgid= 2>/dev/null || true)
  while IFS= read -r line; do
    line=${line//[[:space:]]/}
    [[ "$line" == "$pgid" ]] && return 0
  done <<EOF
$lines
EOF
  return 1
}

kill_group() {
  local pgid=$1 mine i
  [[ "$pgid" =~ ^[0-9]+$ ]] || return 1
  [[ "$pgid" -gt 1 ]] || return 1
  mine=$(own_pgid)
  [[ -n "$mine" && "$pgid" != "$mine" ]] || return 1
  kill -TERM "-$pgid" 2>/dev/null || true
  i=0
  while [[ "$i" -lt 10 ]]; do
    if ! group_has_processes "$pgid"; then
      return 0
    fi
    sleep 0.1
    i=$((i + 1))
  done
  kill -KILL "-$pgid" 2>/dev/null || true
  sleep 0.1
  if group_has_processes "$pgid"; then
    return 1
  fi
  return 0
}

launch_process_matches() {
  local now user cmd
  [[ -n "$launch_pid" ]] || return 1
  user=$(ps_user "$launch_pid")
  [[ "$user" == "$(id -un)" ]] || return 1
  if [[ -n "$launch_identity" ]]; then
    now=$(process_identity "$launch_pid")
    [[ -n "$now" && "$now" == "$launch_identity" && "$user" == "$launch_user" ]]
    return
  fi
  cmd=$(ps -o command= -p "$launch_pid" 2>/dev/null || true)
  [[ -n "$launch_run_dir" && -n "$cmd" ]] || return 1
  case "$cmd" in
    *"$launch_run_dir"*) return 0 ;;
    *) return 1 ;;
  esac
}

note_launch_process() {
  local pid pgid
  pid=$(tmux_cmd display-message -p -t "$(tmux_pane "$launch_session")" '#{pane_pid}')
  [[ "$pid" =~ ^[0-9]+$ ]] || die "session pane pid is missing"
  pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d '[:space:]' || true)
  [[ "$pgid" =~ ^[0-9]+$ ]] || die "session pane pgid is missing"
  launch_pid=$pid
  launch_pgid=$pgid
  launch_user=$(ps_user "$pid")
  [[ "$launch_user" == "$(id -un)" ]] || die "pane owner is ${launch_user:-unknown}"
}

record_proc() {
  local ident
  note_launch_process
  ident=$(process_identity "$launch_pid")
  [[ -n "$ident" ]] || die "cannot record process identity"
  launch_identity=$ident
  {
    printf 'pid=%s\n' "$launch_pid"
    printf 'pgid=%s\n' "$launch_pgid"
    printf 'user=%s\n' "$launch_user"
    printf 'identity=%s\n' "$ident"
  } >"$RUN_DIR/run.proc"
  chmod_file "$RUN_DIR/run.proc"
}

load_proc() {
  local file=$1 line key val saw_pid saw_pgid saw_user saw_ident
  PROC_PID=
  PROC_PGID=
  PROC_USER=
  PROC_IDENTITY=
  saw_pid=0
  saw_pgid=0
  saw_user=0
  saw_ident=0
  [[ -f "$file" && ! -L "$file" ]] || die "run.proc is missing: $file"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line=${line%$'\r'}
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || die "run.proc is not key=value data"
    key=${line%%=*}
    val=${line#*=}
    case "$key" in
      pid)
        [[ "$val" =~ ^[0-9]+$ ]] || die "run.proc pid is not a number"
        PROC_PID=$val
        saw_pid=1
        ;;
      pgid)
        [[ "$val" =~ ^[0-9]+$ ]] || die "run.proc pgid is not a number"
        PROC_PGID=$val
        saw_pgid=1
        ;;
      user)
        [[ "$val" =~ ^[A-Za-z0-9._+-]+$ ]] || die "run.proc user is not a user name"
        PROC_USER=$val
        saw_user=1
        ;;
      identity)
        PROC_IDENTITY=$val
        saw_ident=1
        ;;
      *)
        die "run.proc has an unknown key"
        ;;
    esac
  done <"$file"
  [[ "$saw_pid" -eq 1 && "$saw_pgid" -eq 1 && "$saw_user" -eq 1 && "$saw_ident" -eq 1 ]] || die "run.proc is incomplete"
  [[ -n "$PROC_IDENTITY" ]] || die "run.proc identity is empty"
}

proc_matches_live() {
  local now user pgid
  user=$(ps_user "$PROC_PID")
  now=$(process_identity "$PROC_PID")
  pgid=$(live_pgid "$PROC_PID")
  [[ "$user" == "$PROC_USER" && "$user" == "$(id -un)" && -n "$now" && "$now" == "$PROC_IDENTITY" && -n "$pgid" && "$pgid" == "$PROC_PGID" ]]
}

pane_text() {
  tmux_cmd capture-pane -J -p -t "$(tmux_pane "$SESSION")" -S -
}

match_count() {
  local pane
  pane=$(pane_text)
  printf '%s\n' "$pane" | grep -c -E "$1" || true
}

shell_at_prompt() {
  local last
  last=$(pane_text | sed '/^[[:space:]]*$/d' | tail -n 1)
  [[ "$last" =~ ^"GENVVERIFY>"[[:space:]]*$ ]]
}

wait_for_match() {
  local until=$1 before=$2 timeout=$3 before_exit=$4
  local deadline now exits
  deadline=$((SECONDS + timeout))
  while (( SECONDS < deadline )); do
    now=$(match_count "$until")
    if (( now > before )); then
      return 0
    fi
    if [[ "$EXPECT_EXIT" -eq 0 ]]; then
      exits=$(match_count '^GENV_DRIVE_EXIT:[0-9]+$')
      if (( exits > before_exit )); then
        pane_text >"$EVIDENCE/timeout.txt" || true
        chmod_file "$EVIDENCE/timeout.txt"
        die "command finished before /$until/ appeared. Refusing to leave the session waiting for respond."
      fi
    fi
    sleep 0.2
  done
  pane_text >"$EVIDENCE/timeout.txt" || true
  chmod_file "$EVIDENCE/timeout.txt"
  die "timed out after ${timeout}s waiting for /$until/"
}

save_drive() {
  local label=$1
  local n dir file
  dir=$EVIDENCE/drives
  [[ -d "$EVIDENCE" && ! -L "$EVIDENCE" ]] || die "evidence directory is missing"
  if [[ -L "$dir" ]]; then
    die "drives path is a symlink"
  fi
  if [[ ! -d "$dir" ]]; then
    mkdir -m 700 "$dir"
  fi
  n=$(find "$dir" -name '*.txt' | wc -l | tr -d ' ')
  n=$((n + 1))
  file=$(printf '%s/%03d.txt' "$dir" "$n")
  {
    printf 'command: %s\n' "$label"
    pane_text
  } >"$file"
  chmod_file "$file"
}

newest_exit_code() {
  pane_text | grep -E '^GENV_DRIVE_EXIT:[0-9]+$' | tail -n 1 | cut -d: -f2
}

type_text() {
  local text=$1
  if [[ -n "$text" ]]; then
    tmux_cmd send-keys -t "$(tmux_pane "$SESSION")" -l -- "$text"
  fi
  tmux_cmd send-keys -t "$(tmux_pane "$SESSION")" Enter
}

finish_drive() {
  local until=$1 label=$2 expect_exit=$3
  local code=0
  save_drive "$label"
  printf '%s\n' "$label" >>"$EVIDENCE/commands.log"
  chmod_file "$EVIDENCE/commands.log"
  if [[ "$expect_exit" -eq 1 ]]; then
    code=$(newest_exit_code)
    [[ -n "$code" ]] || die "command finished without GENV_DRIVE_EXIT"
    printf 'exit=%s\n' "$code" >>"$EVIDENCE/commands.log"
    return "$code"
  fi
  printf 'exit=prompt\n' >>"$EVIDENCE/commands.log"
  return 0
}

parse_until() {
  UNTIL='^GENV_DRIVE_EXIT:[0-9]+$'
  TIMEOUT=90
  EXPECT_EXIT=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --until)
        [[ $# -ge 2 ]] || die "drive/respond: --until needs a regex"
        UNTIL=$2
        shift 2
        ;;
      --timeout)
        [[ $# -ge 2 ]] || die "drive/respond: --timeout needs seconds"
        TIMEOUT=$2
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        die "drive/respond: unexpected argument $1"
        ;;
    esac
  done
  if [[ "$UNTIL" != ^GENV_DRIVE_EXIT:* ]]; then
    EXPECT_EXIT=0
  fi
  if [[ "$#" -eq 0 ]]; then
    REMAINING=()
  else
    REMAINING=("$@")
  fi
}

path_has_dotdot() {
  local rest=$1 part
  while [[ "$rest" == */* ]]; do
    part=${rest%%/*}
    [[ "$part" == ".." ]] && return 0
    rest=${rest#*/}
  done
  [[ "$rest" == ".." ]]
}

# go env writes telemetry into the home that runs it. Putting GOTELEMETRY=off
# on the command line does not turn that off. Read the module cache path
# from disk, then run go telemetry off with HOME pointed at the throwaway home.
operator_download_cache() {
  local envf=${HOME}/.config/go/env line val base
  base=${HOME}/go/pkg/mod
  if [[ -f "$envf" && ! -L "$envf" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" == GOMODCACHE=* ]] || continue
      val=${line#GOMODCACHE=}
      case "$val" in
        /*) ;;
        *) continue ;;
      esac
      case "$val" in
        *'$'*|*'`'*|*';'*|*' '*|*$'\n'*) continue ;;
      esac
      base=$val
    done <"$envf"
  fi
  if [[ -d "$base/cache/download" && ! -L "$base/cache/download" ]]; then
    printf '%s\n' "$base/cache/download"
  fi
}

build_genv() {
  local home=$1 out=$2 logfile=$3
  local gocache gomodcache goenv gopath proxy download
  gocache=${GENV_VERIFY_GOCACHE:-$RUN_DIR/gocache}
  gomodcache=${GENV_VERIFY_GOMODCACHE:-$RUN_DIR/gomodcache}
  goenv=$RUN_DIR/goenv
  gopath=$RUN_DIR/gopath
  mkdir -p "$gocache" "$gomodcache" "$gopath"
  proxy=${GOPROXY:-https://proxy.golang.org,direct}
  download=$(operator_download_cache || true)
  if [[ -n "$download" && "$download" != "$gomodcache/cache/download" ]]; then
    proxy="file://${download},${proxy}"
  fi
  (
    printf 'gocache=%s\n' "$gocache"
    printf 'gomodcache=%s\n' "$gomodcache"
    printf 'build_home=%s\n' "$home"
    printf 'goproxy=%s\n' "$proxy"
    if ! env \
      HOME="$home" \
      GOCACHE="$gocache" \
      GOMODCACHE="$gomodcache" \
      GOPATH="$gopath" \
      GOENV="$goenv" \
      GOPROXY="$proxy" \
      GOTOOLCHAIN=go1.26.10 \
      go telemetry off; then
      printf 'go_telemetry=unavailable\n'
    else
      printf 'go_telemetry=off\n'
    fi
    CDPATH='' cd "$REPO"
    env \
      HOME="$home" \
      GOCACHE="$gocache" \
      GOMODCACHE="$gomodcache" \
      GOPATH="$gopath" \
      GOENV="$goenv" \
      GOPROXY="$proxy" \
      GOTOOLCHAIN=go1.26.10 \
      go build -o "$out" .
    printf 'binary=%s\n' "$out"
    env \
      HOME="$home" \
      GOCACHE="$gocache" \
      GOMODCACHE="$gomodcache" \
      GOPATH="$gopath" \
      GOENV="$goenv" \
      GOPROXY="$proxy" \
      GOTOOLCHAIN=go1.26.10 \
      go version
    "$out" version
  ) >"$logfile" 2>&1
}

write_start() {
  local home=$1 xdg=$2 bindir=$3 target=$4
  {
    printf '%s\n' '#!/bin/bash'
    printf '%s\n' "exec env -i \\"
    printf '  HOME=%q \\\n' "$home"
    printf '  XDG_CONFIG_HOME=%q \\\n' "$xdg"
    printf '  XDG_CACHE_HOME=%q \\\n' "$home/.cache"
    printf '  XDG_DATA_HOME=%q \\\n' "$home/.local/share"
    printf '  PATH=%q \\\n' "$bindir:/usr/bin:/bin"
    printf '  SHELL=%q \\\n' /bin/bash
    printf '  TERM=%q \\\n' xterm-256color
    printf '  USER=%q \\\n' "${USER:-verify}"
    printf '  LOGNAME=%q \\\n' "${USER:-verify}"
    printf '  INPUTRC=%q \\\n' "$RUN_DIR/inputrc"
    # CoreFoundation on macOS reads this instead of the operator home.
    printf '  CFFIXED_USER_HOME=%q \\\n' "$home"
    if [[ -n "$target" ]]; then
      printf '  GENV_TARGET=%q \\\n' "$target"
    fi
    printf '  bash --noprofile --rcfile %q -i\n' "$RUN_DIR/verify.bashrc"
  } >"$RUN_DIR/start.sh"
  chmod 700 "$RUN_DIR/start.sh"
}

cmd_launch() {
  local run home xdg bindir evidence session
  local operator_home host_class session_target
  [[ $# -eq 0 ]] || die "launch: unexpected arguments"
  [[ -f "$REPO/go.mod" ]] || die "repository root $REPO has no go.mod"
  command -v go >/dev/null || die "go is not on PATH"
  command -v tmux >/dev/null || die "tmux is not on PATH"
  command -v realpath >/dev/null || die "realpath is not on PATH"
  command -v perl >/dev/null || die "perl is not on PATH"
  ensure_roots create
  run=$(date -u +%Y%m%dT%H%M%SZ)-$$
  run_id_ok "$run" || die "generated run id is not a run id"
  make_private_child "$RUNS_ROOT" "$run"
  RUN_DIR=$CHILD_DIR
  home=$RUN_DIR/home
  xdg=$home/.config
  bindir=$RUN_DIR/bin
  make_private_child "$EVIDENCE_ROOT" "$run"
  evidence=$CHILD_DIR
  session=genv-verify-$run
  operator_home=${HOME:-}
  [[ -n "$operator_home" ]] || die "HOME is empty. Refusing to launch."
  case "$home" in
    "$operator_home"|"$operator_home"/*) die "throwaway home $home is inside operator HOME" ;;
  esac
  case "$evidence" in
    "$RUN_DIR"|"$RUN_DIR"/*) die "evidence directory must sit outside the run directory" ;;
  esac
  host_class=$(classify_host /etc/os-release /proc/version "$(uname -s)")
  session_target=
  if [[ -z "$host_class" ]]; then
    # genv init has no --target flag. linux is the documented catch-all.
    session_target=linux
  fi

  launch_ok=0
  launch_run=$run
  launch_session=$session
  launch_run_dir=$RUN_DIR
  trap on_launch_exit EXIT

  mkdir -p "$home/.config" "$home/.cache" "$home/.local/share" "$bindir" "$evidence/drives"
  chmod 700 "$home" "$home/.config" "$home/.cache" "$home/.local" "$evidence/drives" || true
  write_operator_watch "$evidence/operator-watch.tsv" "$operator_home"
  cp "$evidence/operator-watch.tsv" "$RUN_DIR/operator-watch.tsv"
  chmod_file "$RUN_DIR/operator-watch.tsv"

  cat >"$RUN_DIR/inputrc" <<'EOF'
set enable-bracketed-paste off
set bell-style none
EOF
  # Interactive bash turns job control on after the rc file. That puts a
  # background process in its own group, which cleanup would miss. set +m
  # in PROMPT_COMMAND runs before each prompt and keeps the job in the
  # shell's process group. Save $? first; set +m replaces it with 0.
  cat >"$RUN_DIR/verify.bashrc" <<'EOF'
set +H
set +o history
set +m
PS1='GENVVERIFY> '
PROMPT_COMMAND='__genv_rc=$?; set +m; printf "GENV_DRIVE_EXIT:%s\n" "$__genv_rc"'
EOF
  write_start "$home" "$xdg" "$bindir" "$session_target"
  {
    printf 'run_id=%s\n' "$run"
    printf 'session=%s\n' "$session"
    printf 'host_class=%s\n' "$host_class"
    printf 'session_target=%s\n' "$session_target"
  } >"$RUN_DIR/run.env"
  chmod_file "$RUN_DIR/run.env"
  cp "$RUN_DIR/run.env" "$evidence/run.env"
  chmod_file "$evidence/run.env"

  if ! build_genv "$home" "$bindir/genv" "$evidence/build.log"; then
    die "go build failed. See $evidence/build.log"
  fi
  chmod_file "$evidence/build.log"

  : >"$evidence/pane.log"
  chmod_file "$evidence/pane.log"
  tmux_cmd new-session -d -s "$session" -c "$home" -- "$RUN_DIR/start.sh"
  SESSION=$session
  EVIDENCE=$evidence
  note_launch_process
  local deadline
  deadline=$((SECONDS + 20))
  while (( SECONDS < deadline )); do
    if ! tmux_cmd has-session -t "$(tmux_session "$session")" 2>/dev/null; then
      die "session $session exited before the GENVVERIFY prompt"
    fi
    if pane_text 2>/dev/null | grep -q 'GENVVERIFY>'; then
      break
    fi
    sleep 0.2
  done
  if ! pane_text 2>/dev/null | grep -q 'GENVVERIFY>'; then
    die "session did not reach the GENVVERIFY prompt"
  fi
  record_proc
  tmux_cmd pipe-pane -t "$(tmux_pane "$session")" -o "cat >> $(printf '%q' "$evidence/pane.log")" || printf 'verify-genv: pane log not attached\n' >&2
  chmod_file "$evidence/pane.log"

  launch_ok=1
  trap - EXIT
  printf 'run_id=%s\n' "$run"
  printf 'home=%s\n' "$home"
  printf 'spec_dir=%s\n' "$xdg/genv"
  printf 'evidence=%s\n' "$evidence"
  printf 'session=%s\n' "$session"
  printf 'binary=%s\n' "$bindir/genv"
  if [[ -n "$session_target" ]]; then
    printf 'session_target=%s\n' "$session_target"
  else
    printf 'session_target=\n'
  fi
}

cmd_paths() {
  load_state
  case "${1:-}" in
    home) printf '%s\n' "$VERIFY_HOME" ;;
    spec-dir) printf '%s\n' "$XDG/genv" ;;
    spec) printf '%s\n' "$XDG/genv/genv.json" ;;
    evidence) printf '%s\n' "$EVIDENCE" ;;
    binary) printf '%s\n' "$BINDIR/genv" ;;
    session) printf '%s\n' "$SESSION" ;;
    run-id) printf '%s\n' "$RUN_ID" ;;
    *)
      printf 'run_id=%s\n' "$RUN_ID"
      printf 'home=%s\n' "$VERIFY_HOME"
      printf 'spec_dir=%s\n' "$XDG/genv"
      printf 'spec=%s\n' "$XDG/genv/genv.json"
      printf 'evidence=%s\n' "$EVIDENCE"
      printf 'session=%s\n' "$SESSION"
      printf 'binary=%s\n' "$BINDIR/genv"
      ;;
  esac
}

cmd_drive() {
  local before before_exit label
  load_state
  tmux_cmd has-session -t "$(tmux_session "$SESSION")" 2>/dev/null || die "session $SESSION is not running"
  parse_until "$@"
  [[ ${#REMAINING[@]} -gt 0 ]] || die "drive: missing command after --"
  label="${REMAINING[*]}"
  before=$(match_count "$UNTIL")
  before_exit=$(match_count '^GENV_DRIVE_EXIT:[0-9]+$')
  type_text "$label"
  wait_for_match "$UNTIL" "$before" "$TIMEOUT" "$before_exit"
  finish_drive "$UNTIL" "$label" "$EXPECT_EXIT"
}

cmd_respond() {
  local before before_exit text label
  load_state
  tmux_cmd has-session -t "$(tmux_session "$SESSION")" 2>/dev/null || die "session $SESSION is not running"
  parse_until "$@"
  if [[ ${#REMAINING[@]} -eq 0 ]]; then
    text=
  elif [[ ${#REMAINING[@]} -eq 1 ]]; then
    text=${REMAINING[0]}
  else
    die "respond: pass one text argument after --"
  fi
  if shell_at_prompt; then
    die "respond: the session is at GENVVERIFY>. The previous command already finished. Refusing to type into the shell."
  fi
  label="respond:${text}"
  before=$(match_count "$UNTIL")
  before_exit=$(match_count '^GENV_DRIVE_EXIT:[0-9]+$')
  type_text "$text"
  wait_for_match "$UNTIL" "$before" "$TIMEOUT" "$before_exit"
  finish_drive "$UNTIL" "$label" "$EXPECT_EXIT"
}

capture_reserved() {
  case "$1" in
    operator-watch.tsv|run.env|run.proc|build.log|pane.log|commands.log|cleanup-ok.txt|cleanup-failed.txt|timeout.txt|feature.txt|drives)
      return 0
      ;;
  esac
  return 1
}

# Open the source once and copy that descriptor. realpath and a later open
# are not the same file if the directory is swapped in between.
copy_nofollow() {
  local src=$1 dest=$2 home_real=$3 evidence_real=$4 name=$5 err
  if ! err=$(perl - "$src" "$dest" "$home_real" "$evidence_real" "$name" 2>&1 <<'PERL'
use strict;
use Fcntl qw(O_RDONLY O_WRONLY O_CREAT O_EXCL O_NOFOLLOW);
use Cwd qw(realpath);

my ($src, $dst, $home_real, $evidence_real, $name) = @ARGV;
die "capture args\n" unless defined $name && $name ne "";

sub inside {
  my ($root, $path) = @_;
  return 0 unless defined $path && defined $root && $root ne "";
  return 0 if $path eq $root;
  my $prefix = $root;
  $prefix .= "/" unless substr($prefix, -1) eq "/";
  return rindex($path, $prefix, 0) == 0;
}

sub fd_path {
  my ($fh) = @_;
  my $n = fileno($fh);
  my $proc = "/proc/self/fd/$n";
  if (-e $proc) {
    my $link = readlink($proc);
    return $link if defined $link && $link ne "";
  }
  my $buf = "\0" x 4096;
  if (fcntl($fh, 50, $buf)) {
    $buf =~ s/\0.*//s;
    return $buf if $buf ne "";
  }
  return;
}

sysopen(my $in, $src, O_RDONLY | O_NOFOLLOW) or die "open src: $!\n";
die "source is not a file\n" unless -f $in;
my $opened = fd_path($in);
die "cannot resolve opened file\n" unless defined $opened && $opened ne "";
my $real = realpath($opened);
die "cannot resolve opened file\n" unless defined $real;
die "opened file is outside the throwaway home\n" unless inside($home_real, $real);

my $expect = $evidence_real . "/" . $name;
sysopen(my $out, $dst, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) or die "open dst: $!\n";
while (1) {
  my $n = sysread($in, my $buf, 8192);
  die "read: $!\n" unless defined $n;
  last if $n == 0;
  my $off = 0;
  while ($off < length($buf)) {
    my $w = syswrite($out, $buf, length($buf) - $off, $off);
    die "write: $!\n" unless defined $w;
    $off += $w;
  }
}
close $in or die "close src: $!\n";
close $out or die "close dst: $!\n";
my $dest_real = realpath($dst);
die "evidence file escaped the evidence directory\n" unless defined $dest_real && $dest_real eq $expect;
PERL
  ); then
    die "capture: ${err:-refusing to copy}"
  fi
}

cmd_capture() {
  local name=${1:-} path=${2:-} dest home_real evidence_real dir dir_real dest_real
  [[ -n "$name" && -n "$path" ]] || die "capture: usage: verify-genv capture <name> <absolute-path>"
  load_state
  case "$name" in
    */*|*..*|.*) die "capture: name must be a single path segment" ;;
  esac
  if capture_reserved "$name"; then
    die "capture: $name is reserved"
  fi
  [[ "$path" == /* ]] || die "capture: path must be absolute"
  if path_has_dotdot "$path"; then
    die "capture: refusing '..' in $path"
  fi
  home_real=$(realpath -e "$VERIFY_HOME") || die "capture: throwaway home is missing"
  evidence_real=$(realpath -e "$EVIDENCE") || die "capture: evidence directory is missing"
  if [[ -L "$path" ]]; then
    die "capture: refusing symlink $path"
  fi
  dir=$(dirname -- "$path")
  while true; do
    if [[ -L "$dir" ]]; then
      die "capture: refusing symlink $dir"
    fi
    dir_real=$(realpath -e -- "$dir" 2>/dev/null) || die "capture: $path is outside the throwaway home"
    if [[ "$dir_real" == "$home_real" ]]; then
      break
    fi
    case "$dir_real" in
      "$home_real"/*) ;;
      *) die "capture: $path is outside the throwaway home" ;;
    esac
    [[ "$dir" == "/" ]] && die "capture: $path is outside the throwaway home"
    dir=$(dirname -- "$dir")
  done
  [[ -e "$path" ]] || die "capture: $path is not a file"
  dest=$EVIDENCE/$name
  if [[ -L "$dest" ]]; then
    die "capture: refusing symlink at $dest"
  fi
  if [[ -e "$dest" ]]; then
    dest_real=$(realpath -e -- "$dest" 2>/dev/null) || die "capture: $dest is outside the evidence directory"
    [[ "$dest_real" == "$evidence_real/$name" ]] || die "capture: $dest is outside the evidence directory"
    [[ -f "$dest" ]] || die "capture: $dest is not a file"
    rm -f -- "$dest"
  fi
  copy_nofollow "$path" "$dest" "$home_real" "$evidence_real" "$name"
  dest_real=$(realpath -e -- "$dest" 2>/dev/null) || die "capture: evidence file escaped the evidence directory"
  [[ "$dest_real" == "$evidence_real/$name" ]] || die "capture: evidence file escaped the evidence directory"
  [[ ! -L "$dest" && -f "$dest" ]] || die "capture: evidence file is not a regular file"
  printf '%s\n' "$dest"
}

cmd_doctor() {
  local doctor_file line got want_target
  [[ $# -eq 0 ]] || die "doctor: unexpected arguments"
  load_state
  tmux_cmd has-session -t "$(tmux_session "$SESSION")" 2>/dev/null || die "session $SESSION is not running"
  check_operator_watch "$EVIDENCE/operator-watch.tsv" || die "operator config changed"
  [[ -x "$BINDIR/genv" ]] || die "built binary missing at $BINDIR/genv"
  doctor_file=$VERIFY_HOME/.genv-verify-doctor
  rm -f "$doctor_file"
  # The session shell expands HOME and command -v. This process must not.
  # shellcheck disable=SC2016
  cmd_drive -- 'printf "HOME=%s\nXDG=%s\nGENV=%s\nNOI=%s\nTARGET=%s\nHOSTENV=%s\nSHELL=%s\n" "$HOME" "$XDG_CONFIG_HOME" "$(command -v genv)" "${GENV_NO_INTERACTIVE-unset}" "${GENV_TARGET-unset}" "${GENV_HOST-unset}" "$SHELL" > "$HOME/.genv-verify-doctor"'
  [[ -f "$doctor_file" ]] || die "doctor file was not written"
  got=$(grep '^HOME=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "$VERIFY_HOME" ]] || die "HOME inside session is $got, want $VERIFY_HOME"
  got=$(grep '^XDG=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "$XDG" ]] || die "XDG_CONFIG_HOME inside session is $got, want $XDG"
  got=$(grep '^GENV=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "$BINDIR/genv" ]] || die "genv on PATH is $got, want $BINDIR/genv"
  got=$(grep '^NOI=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "unset" ]] || die "GENV_NO_INTERACTIVE is set inside the session ($got)"
  want_target="unset"
  if [[ -n "$SESSION_TARGET" ]]; then
    want_target=$SESSION_TARGET
  fi
  got=$(grep '^TARGET=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "$want_target" ]] || die "GENV_TARGET inside the session is $got, harness expects $want_target"
  got=$(grep '^HOSTENV=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "unset" ]] || die "GENV_HOST is set inside the session ($got)"
  got=$(grep '^SHELL=' "$doctor_file" | cut -d= -f2-)
  [[ "$got" == "/bin/bash" ]] || die "SHELL inside session is $got, want /bin/bash"
  cmd_drive -- genv version
  line=$(pane_text | grep -E '^genv ' | tail -n 1 || true)
  [[ -n "$line" ]] || die "genv version did not print a version line"
  check_operator_watch "$EVIDENCE/operator-watch.tsv" || die "operator config changed"
  printf 'doctor ok\n%s\n' "$line"
}

stop_recorded_process() {
  local procf=$1 live
  [[ -f "$procf" ]] || return 0
  load_proc "$procf"
  if ! pid_alive "$PROC_PID"; then
    return 0
  fi
  live=$(live_pgid "$PROC_PID")
  # The saved pgid is only a check. Signal the group the live pid is in.
  if ! proc_matches_live || [[ -z "$live" || "$live" != "$PROC_PGID" ]]; then
    printf 'verify-genv: process identity does not match pid %s. Refusing to signal or remove this run.\n' "$PROC_PID" >&2
    exit 1
  fi
  kill_group "$live" || die "refusing to signal process group $live"
}

cmd_cleanup() {
  local run envf session_name watch_ok
  if [[ $# -ne 1 || -z "${1:-}" ]]; then
    die "cleanup requires the run id. Pass the id launch printed. Refusing to guess."
  fi
  run=$1
  run_id_ok "$run" || die "cleanup: run id is not a run id"
  ensure_roots
  if [[ -f "$RUNS_ROOT/$run/run.env" && ! -L "$RUNS_ROOT/$run/run.env" ]]; then
    envf=$RUNS_ROOT/$run/run.env
  elif [[ -f "$EVIDENCE_ROOT/$run/run.env" && ! -L "$EVIDENCE_ROOT/$run/run.env" ]]; then
    envf=$EVIDENCE_ROOT/$run/run.env
  else
    die "cleanup: no run $run. Refusing to guess."
  fi
  load_run_record "$envf" "$run"
  session_name=$SESSION
  [[ "$session_name" == "genv-verify-$run" ]] || die "cleanup: session does not match $run"
  [[ -d "$EVIDENCE" && ! -L "$EVIDENCE" ]] || die "evidence directory $EVIDENCE is missing before cleanup"
  private_dir_ok "$EVIDENCE" || die "evidence directory is not private"
  [[ -f "$EVIDENCE/operator-watch.tsv" && ! -L "$EVIDENCE/operator-watch.tsv" ]] || die "evidence is missing operator-watch.tsv"
  if [[ -d "$RUN_DIR" && ! -L "$RUN_DIR" && -f "$RUN_DIR/run.proc" ]]; then
    stop_recorded_process "$RUN_DIR/run.proc"
  fi
  if tmux_cmd has-session -t "$(tmux_session "$session_name")" 2>/dev/null; then
    tmux_cmd kill-session -t "$(tmux_session "$session_name")"
  fi
  if tmux_cmd has-session -t "$(tmux_session "$session_name")" 2>/dev/null; then
    die "session $session_name is still running"
  fi
  watch_ok=0
  if check_operator_watch "$EVIDENCE/operator-watch.tsv"; then
    watch_ok=1
  fi
  [[ -n "$RUNS_ROOT" && "$RUNS_ROOT" != "/" && -n "$run" ]] || die "refusing to remove run directory"
  [[ "$RUN_DIR" == "$RUNS_ROOT/$run" ]] || die "refusing to remove $RUN_DIR"
  if [[ -L "$RUN_DIR" ]]; then
    die "refusing to remove symlink $RUN_DIR"
  fi
  remove_tree "$RUN_DIR"
  [[ -d "$EVIDENCE" ]] || die "cleanup removed evidence directory $EVIDENCE"
  if [[ "$watch_ok" -ne 1 ]]; then
    printf 'operator config changed\n' >"$EVIDENCE/cleanup-failed.txt"
    chmod_file "$EVIDENCE/cleanup-failed.txt"
    die "cleanup removed the session, and the operator config fingerprint changed"
  fi
  printf 'session=dead\nhome=removed\nevidence=%s\n' "$EVIDENCE" >"$EVIDENCE/cleanup-ok.txt"
  chmod_file "$EVIDENCE/cleanup-ok.txt"
  printf 'cleaned %s\nevidence %s\n' "$run" "$EVIDENCE"
}

main() {
  local cmd=${1:-}
  if [[ -z "$cmd" ]]; then
    usage
    exit 1
  fi
  shift
  case "$cmd" in
    launch) cmd_launch "$@" ;;
    doctor) cmd_doctor "$@" ;;
    paths) cmd_paths "$@" ;;
    drive) cmd_drive "$@" ;;
    respond) cmd_respond "$@" ;;
    capture) cmd_capture "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    classify) cmd_classify "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command $cmd" ;;
  esac
}

main "$@"
