{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ks1686/genv/schema/v10/genv.json",
  "title": "genv.json",
  "description": "genv portable targets manifest with local module composition - schema version 10",
  "type": "object",
  "required": [
    "schemaVersion",
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "const": "10"
    },
    "repo": {
      "type": "object"
    },
    "updates": {
      "type": "object"
    },
    "defaults": {
      "$ref": "#/$defs/defaultBundle"
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "macos",
          "windows",
          "arch",
          "ubuntu",
          "wsl-arch",
          "linux"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/targetBundle"
      }
    },
    "packages": {
      "type": "array",
      "maxItems": 0
    },
    "env": {
      "type": "null"
    },
    "shell": {
      "type": "null"
    },
    "files": {
      "type": "null"
    },
    "services": {
      "type": "null"
    },
    "hooks": {
      "type": "null"
    },
    "adapters": {
      "type": "object"
    },
    "modules": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "defaultBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "env": {
          "type": "object"
        },
        "shell": {
          "type": "object"
        },
        "files": {
          "type": "object"
        },
        "services": {
          "type": "object"
        },
        "hooks": {
          "type": "object"
        },
        "useModules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "targetBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "env": {
          "type": "object"
        },
        "shell": {
          "type": "object"
        },
        "files": {
          "type": "object"
        },
        "services": {
          "type": "object"
        },
        "hooks": {
          "type": "object"
        },
        "useModules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "package": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "prefer": {
          "description": "Package manager that installs this package: a built-in manager, or an adapter declared in the top-level \"adapters\" block.",
          "anyOf": [{ "enum": ["apk", "apt", "asdf", "brew", "bun", "cargo", "choco", "composer", "conda", "deno", "dnf", "dotnet-tool", "external", "gem", "ghcup", "go", "helm", "juliaup", "krew", "linuxbrew", "mamba", "mas", "mise", "npm", "opam", "pacman", "paru", "pip-user", "pipx", "pixi", "pnpm", "poetry", "rustup", "scoop", "sdkman", "snap", "stack", "uv", "volta", "vscode", "winget", "yarn", "yay"] }, { "pattern": "^[a-z][a-z0-9-]*$", "description": "Custom adapter name declared in the top-level \"adapters\" block (schema v8 and later)." }]
        },
        "managers": {
          "type": "object",
          "description": "Manager-specific package identifiers (for packages with different names across managers).",
          "propertyNames": {"anyOf": [{ "enum": ["apk", "apt", "asdf", "brew", "bun", "cargo", "choco", "composer", "conda", "deno", "dnf", "dotnet-tool", "external", "gem", "ghcup", "go", "helm", "juliaup", "krew", "linuxbrew", "mamba", "mas", "mise", "npm", "opam", "pacman", "paru", "pip-user", "pipx", "pixi", "pnpm", "poetry", "rustup", "scoop", "sdkman", "snap", "stack", "uv", "volta", "vscode", "winget", "yarn", "yay"] }, { "pattern": "^[a-z][a-z0-9-]*$", "description": "Custom adapter name declared in the top-level \"adapters\" block (schema v8 and later)." }]},
          "additionalProperties": {
            "type": "string"
          }
        },
        "external": {
          "$ref": "#/$defs/externalRecipe"
        }
      }
    },
    "externalRecipe": {
      "type": "object",
      "required": [
        "detect",
        "source",
        "platforms"
      ],
      "additionalProperties": false,
      "properties": {
        "detect": {
          "$ref": "#/$defs/externalDetect"
        },
        "source": {
          "$ref": "#/$defs/externalSource"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/externalPlatform"
          }
        },
        "verify": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalVerification"
          }
        },
        "allowUnverified": {
          "type": "boolean"
        },
        "allowInsecureHTTP": {
          "type": "boolean"
        },
        "allowBackgroundExecution": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verify": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "allowUnverified": {
                "const": true
              }
            },
            "required": [
              "allowUnverified"
            ]
          }
        }
      ]
    },
    "externalDetect": {
      "type": "object",
      "required": [
        "command",
        "versionRegex"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "versionRegex": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "externalSource": {
      "oneOf": [
        {
          "$ref": "#/$defs/githubSource"
        },
        {
          "$ref": "#/$defs/httpSource"
        }
      ]
    },
    "githubSource": {
      "type": "object",
      "required": [
        "type",
        "repository"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "githubRelease"
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "release": {
          "enum": [
            "stable",
            "prerelease",
            "any"
          ]
        },
        "tagRegex": {
          "type": "string"
        },
        "apiBase": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "httpSource": {
      "type": "object",
      "required": [
        "type",
        "versionURL",
        "format"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "httpRelease"
        },
        "versionURL": {
          "type": "string",
          "format": "uri"
        },
        "format": {
          "enum": [
            "json",
            "text"
          ]
        },
        "versionPointer": {
          "type": "string"
        },
        "versionRegex": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "format": {
              "const": "json"
            }
          },
          "required": [
            "versionPointer"
          ]
        },
        {
          "properties": {
            "format": {
              "const": "text"
            }
          },
          "required": [
            "versionRegex"
          ]
        }
      ]
    },
    "externalPlatform": {
      "type": "object",
      "required": [
        "os",
        "arch",
        "install"
      ],
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "linux",
              "darwin",
              "windows"
            ]
          }
        },
        "arch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "amd64",
              "arm64"
            ]
          }
        },
        "libc": {
          "type": "array",
          "items": {
            "enum": [
              "glibc",
              "musl"
            ]
          }
        },
        "assetRegex": {
          "type": "string"
        },
        "artifactURL": {
          "type": "string"
        },
        "install": {
          "$ref": "#/$defs/externalInstall"
        }
      },
      "oneOf": [
        {
          "required": [
            "assetRegex"
          ],
          "not": {
            "required": [
              "artifactURL"
            ]
          }
        },
        {
          "required": [
            "artifactURL"
          ],
          "not": {
            "required": [
              "assetRegex"
            ]
          }
        }
      ]
    },
    "externalInstall": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "direct",
            "archive",
            "script"
          ]
        },
        "scope": {
          "enum": [
            "user",
            "system"
          ]
        },
        "destination": {
          "type": "string"
        },
        "stripComponents": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalInstallFile"
          }
        },
        "interpreter": {
          "enum": [
            "sh",
            "bash",
            "pwsh",
            "powershell"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "uninstall": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "direct"
            }
          },
          "required": [
            "destination"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "files"
                ]
              },
              {
                "required": [
                  "interpreter"
                ]
              },
              {
                "required": [
                  "args"
                ]
              },
              {
                "required": [
                  "env"
                ]
              },
              {
                "required": [
                  "uninstall"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "archive"
            }
          },
          "required": [
            "files"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "destination"
                ]
              },
              {
                "required": [
                  "interpreter"
                ]
              },
              {
                "required": [
                  "args"
                ]
              },
              {
                "required": [
                  "env"
                ]
              },
              {
                "required": [
                  "uninstall"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "script"
            }
          },
          "required": [
            "interpreter"
          ],
          "not": {
            "required": [
              "files"
            ]
          }
        }
      ]
    },
    "externalInstallFile": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "pattern": "^0?[0-7]{3}$"
        }
      }
    },
    "externalVerification": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "githubDigest",
            "sha256",
            "sha256File",
            "sigstore",
            "minisign",
            "openpgp"
          ]
        },
        "assetRegex": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "valuePointer": {
          "type": "string"
        },
        "signatureAssetRegex": {
          "type": "string"
        },
        "bundleAssetRegex": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "publicKey": {
          "type": "string"
        },
        "publicKeyFile": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      }
    },
    "moduleDocument": {
      "type": "object",
      "required": [
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "10"
        },
        "requiresModules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          }
        },
        "defaults": {
          "$ref": "#/$defs/defaultBundle"
        },
        "targets": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "macos",
              "windows",
              "arch",
              "ubuntu",
              "wsl-arch",
              "linux"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/targetBundle"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "defaults"
          ]
        },
        {
          "required": [
            "targets"
          ]
        }
      ]
    },
    "moduleBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "env": {
          "type": "object"
        },
        "shell": {
          "type": "object"
        },
        "files": {
          "type": "object"
        },
        "services": {
          "type": "object"
        },
        "hooks": {
          "type": "object"
        }
      },
      "not": {
        "required": [
          "useModules"
        ]
      }
    }
  }
}
