{
  "$schema": "https://opencode.ai/config.json",
  "name": "genv",
  "description": "Global Environment Manager - Go CLI for tracking and syncing software environments",
  "instructions": [
    "./AGENTS.md"
  ],
  "lsp": {
    "go": {
      "command": "gopls",
      "enabled": true
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp",
        "--project",
        "."
      ],
      "enabled": true
    }
  },
  "test": {
    "command": "go test ./...",
    "patterns": [
      "**/*_test.go"
    ]
  },
  "ignore": [
    "vendor/",
    "dist/",
    "coverage.out",
    "coverage.html",
    ".DS_Store",
    "*.log"
  ]
}
